    {
      "@id": "ihh:MUI-F-0061",
      "@type": "Claim",
      "text": "John Muir led the fight against the damming of the Hetch Hetchy Valley as a reservoir for the city of San Francisco.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "career",
      "ihh:place": "Hetch Hetchy Valley",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:MUI-S-0028"
        },
        {
          "@id": "ihh:MUI-S-0012"
        }
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "ihh:MUI-S-0028"
        },
        {
          "@id": "ihh:MUI-S-0012"
        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0028"
          },
          "ihh:quote": "John Muir, the leading preservationist of his day and founder of the Sierra Club, led the fight against the damming of the Hetch Hetchy Valley as a reservoir for the city of San Francisco.",
          "ihh:locator": "item.summary[0]"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0012"
          },
          "ihh:quote": "Yesterday, December 19, was the centennial of the Raker Act, the bill that allowed the building of a dam in the Hetch Hetchy Valley.",
          "ihh:locator": "paragraph 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0012"
          },
          "ihh:quote": "John Muir, who led the opposition, wrote beautifully about the valley, calling it “one of Nature's rarest and most precious mountain temples.”",
          "ihh:locator": "paragraph 5"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0012"
          },
          "ihh:quote": "In the end, the Raker Act became law on December 19, 1913 and San Francisco celebrated its new water security, a pristine watershed preserved in a national park.",
          "ihh:locator": "paragraph 6"
        }
      ],
      "ihh:extractor": {
        "ihh:model": "claude:claude-opus-5-5",
        "ihh:runId": "muir-2026-10-09",
        "ihh:date": "2026-10-09",
        "ihh:verdict": "supported"
      },
      "prov:wasGeneratedBy": {
        "@id": "ihh:run-muir-muir-2026-10-09"
      },
      "ihh:adversary": {
