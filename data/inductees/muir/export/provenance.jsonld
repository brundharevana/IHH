      "@id": "ihh:MUI-F-0020",
      "@type": "Claim",
      "text": "In 1890, Muir's articles \"The Treasures of Yosemite\" and \"Features of a Proposed Yosemite National Park\" appeared in Century Magazine.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "work",
      "ihh:eventDate": "1890",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:MUI-S-0011"
        },
        {
          "@id": "ihh:MUI-S-0024"
        }
      ],
