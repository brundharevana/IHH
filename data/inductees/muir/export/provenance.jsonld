      "@id": "ihh:MUI-F-0018",
      "@type": "Claim",
      "text": "In 1892, John Muir and a number of prominent Californians incorporated the Sierra Club.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "career",
      "ihh:eventDate": "1892",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
