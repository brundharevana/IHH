      "@id": "ihh:MUI-F-0021",
      "@type": "Claim",
      "text": "In 1909, John Muir urged the public to “ask Congress to reject this destructive bill,” a bill that would allow a dam to be built in Hetch Hetchy Valley.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "career",
      "ihh:eventDate": "1909",
      "ihh:status": "single-source",
