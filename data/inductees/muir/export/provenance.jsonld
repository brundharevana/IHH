      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0017"
          },
          "ihh:quote": "1892: Founded the Sierra Club, marking the end of his ranching career.",
          "ihh:locator": "Middle Years and Major Achievements, 1892"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0019"
          },
          "ihh:quote": "in 1892 he established the Sierra Club",
          "ihh:locator": "paragraph 11"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0021"
          },
          "ihh:quote": "In 1892, Muir and other citizens banded together and established the Sierra Club.",
          "ihh:locator": "Creation of Yosemite National Park"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0083"
          },
          "ihh:quote": "The Sierra Club, an American environmental organization headquartered in San Francisco, developed a reputation in the 1960s as an aggressive defender of wild lands.",
          "ihh:locator": "Description, sentence 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0083"
          },
          "ihh:quote": "The organization was founded in 1892 by John Muir, a Scottish American naturalist and essayist.",
          "ihh:locator": "Description, sentence 3"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0076"
          },
          "ihh:quote": "In recent years, the Sierra Club, an environmental organization that Muir helped found in 1892, has acknowledged Muir’s marginalization of Native Americans and his exclusion of people of color from conservation efforts.",
          "ihh:locator": "Exhibition Label, paragraph 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0084"
          },
          "ihh:quote": "He founded the Sierra Club, the oldest and largest environmental organizations in the United States.",
          "ihh:locator": "Description, sentence 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0074"
          },
          "ihh:quote": "John Muir (1838 –1914) was a Scottish-born American naturalist, author, and early advocate of preservation of wilderness in the United States.",
          "ihh:locator": "page text, project description paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0074"
          },
          "ihh:quote": "The Sierra Club, which he founded, is now one of the most important conservation organizations in the United States.",
          "ihh:locator": "page text, project description paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0028"
          },
          "ihh:quote": "John Muir, the leading preservationist of his day and founder of the Sierra Club",
          "ihh:locator": "item.summary[0]"
        }
      ],
      "ihh:extractor": {
