    {
      "@id": "ihh:MUI-F-0049",
      "@type": "Claim",
      "text": "Muir is buried in the Strentzel family cemetery, Alhambra Valley, Martinez, California.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "death",
      "ihh:eventDate": "1914",
      "ihh:place": "Alhambra Valley, Martinez, California",
