        "ihh:runId": "adv-20261009T154745-52cf",
        "ihh:date": "2026-10-09",
        "ihh:verdict": "supported",
        "ihh:quoteInSnapshot": true,
        "ihh:quoteInLive": "yes",
        "ihh:entailed": true,
