        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0030"
          },
          "ihh:quote": "The Scottish-born naturalist, conservationist, and writer John Muir (1838-1914)",
          "ihh:locator": "item.summary[0]"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0074"
          },
          "ihh:quote": "John Muir (1838 –1914) was a Scottish-born American naturalist, author, and early advocate of preservation of wilderness in the United States.",
          "ihh:locator": "page text, project description paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0010"
          },
          "ihh:quote": "Born in Scotland, John Muir emigrated with his family in 1849, settling at Fountain Lake, near Portage, Wisconsin.",
          "ihh:locator": "paragraph 3"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0025"
          },
          "ihh:quote": "A Scottish-born journalist and naturalist, John Muir (1838-1914) studied botany and geology at the University of Wisconsin (1861-1863).",
          "ihh:locator": "Biographical / historical, paragraph 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0085"
          },
          "ihh:quote": "He was a Scottish-born American naturalist, author, and an advocate for the preservation of wilderness in the United States and the National Park Service.",
