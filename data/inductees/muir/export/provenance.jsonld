      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0011"
          },
          "ihh:quote": "In 1890, unchecked grazing, logging and tourism were damaging Yosemite.",
          "ihh:locator": "Sharing a Progressive Vision, paragraph 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0011"
          },
          "ihh:quote": "Muir's articles \"The Treasures of Yosemite\" and \"Features of a Proposed Yosemite National Park\" appeared in Century Magazine, which boasted more than one million readers.",
          "ihh:locator": "Sharing a Progressive Vision, paragraph 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0024"
          },
          "ihh:quote": "1890\nApril 21 : John Muir turns 52 years old.\nFourth trip to Alaska ; 10 day solo-expedition by sled across Muir Glacier.\nMuir's articles on Yosemite, The Treasures of Yosemite and Features of the Proposed Yosemite National Park published in Century magazine , which greatly aid the campaign to establish Yosemite National Park.",
          "ihh:locator": "1890"
        }
      ],
