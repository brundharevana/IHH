    {
      "@id": "ihh:MUI-F-0048",
      "@type": "Claim",
      "text": "In 1913 Muir is awarded an honorary Doctor of Laws degree by the University of California.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "award",
      "ihh:eventDate": "1913",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
