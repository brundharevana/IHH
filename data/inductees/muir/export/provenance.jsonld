      "@id": "ihh:MUI-F-0150",
      "@type": "Claim",
      "text": "John Muir lived in North Hall at the University of Wisconsin.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "education",
      "ihh:place": "North Hall, University of Wisconsin",
      "ihh:status": "disputed",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:MUI-S-0024"
