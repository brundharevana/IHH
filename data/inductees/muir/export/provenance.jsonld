        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0013"
          },
          "ihh:quote": "In 1909, many conservation writers showed opposition to a bill that would allow a dam to be built in Hetch Hetchy Valley, with Isaac Branson writing that “San Francisco has no urgent or even reasonable need at all of this Hetch-Hetchy region for her Water Supply,” and John Muir urging the public to “ask Congress to reject this destructive bill.”",
          "ihh:locator": "paragraph on 1909 debate"
        }
      ],
