      "@type": "Claim",
      "text": "Madeleine Albright's family fled Czechoslovakia.",
      "about": {
        "@id": "ihh:person-albright"
      },
      "ihh:category": "immigration",
      "ihh:place": "Czechoslovakia",
      "ihh:status": "verified",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
