    {
      "@id": "ihh:ALB-F-0022",
      "@type": "Claim",
      "text": "Madeleine Korbel Albright was nominated to be the first woman Secretary of State by President William Jefferson Clinton on December 5, 1996.",
      "about": {
        "@id": "ihh:person-albright"
      },
      "ihh:category": "career",
      "ihh:eventDate": "1996-12-05",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
