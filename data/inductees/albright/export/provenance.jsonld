    {
      "@id": "ihh:ALB-F-0204",
      "@type": "Claim",
      "text": "Madeleine Albright's first trans-Atlantic crossing was on the SS America.",
      "about": {
        "@id": "ihh:person-albright"
      },
      "ihh:category": "immigration",
      "ihh:status": "verified",
      "ihh:primaryDocument": true,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:ALB-S-0154"
        }
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "ihh:ALB-S-0154"
        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0154"
          },
          "ihh:quote": "You know, from that first trans-Atlantic crossing on the SS America, to landing in nations around the world in that big blue-and-white plane emblazoned with the words “United States of America,” Madeleine understood her story was America’s story.",
          "ihh:locator": "President Biden's remarks, paragraph on her travels"
        }
      ],
      "ihh:extractor": {
        "ihh:model": "claude:claude-opus-5-5",
        "ihh:runId": "round9-2026-10-29",
