        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0016"
          },
          "ihh:quote": "During her tenure, she worked to enlarge NATO and helped lead the Alliance’s campaign against terror and ethnic cleansing in the Balkans, pursued peace in the Middle East and Africa, sought to reduce the dangerous spread of nuclear weapons, and was a champion of democracy, human rights, and good governance across the globe.",
          "ihh:locator": "Press release, entry 'Madeleine Albright'"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0001"
          },
          "ihh:quote": "She championed NATO expansion, U.S. intervention in Kosovo, and global democracy.",
          "ihh:locator": "BIOGRAPHY section"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0015"
          },
          "ihh:quote": "As Secretary of State, Dr. Albright reinforced America’s alliances, advocated for democracy and human rights, and promoted American trade, business, labor, and environmental standards abroad.",
          "ihh:locator": "About the Secretary"
        }
      ],
      "ihh:extractor": {
