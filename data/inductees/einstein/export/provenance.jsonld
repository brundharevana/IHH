      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:EIN-S-0092"
          },
          "ihh:quote": "THE annual meeting of the National Academy of Sciences was held at the Smithsonian Institution on April 25–27. Unusual interest was taken in the meetings owing to the presence of his Serene Highness Albert I., Prince of Monaco, Prof, and Mrs. Albert Einstein",
          "ihh:locator": "Abstract"
        },
        {
          "ihh:source": {
