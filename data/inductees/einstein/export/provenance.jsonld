          },
          "ihh:quote": "Nature volume 107, pages 539–540 (1921)",
          "ihh:locator": "citation line"
        },
        {
          "ihh:source": {
            "@id": "ihh:EIN-S-0074"
          },
          "ihh:quote": "at meeting here\nDr. Einstein and Prince ol\nMonaco Guests of National\nAcademy of Sciences.",
          "ihh:locator": "page OCR text, headline of the article 'Noted scientists at meeting here'"
        },
        {
          "ihh:source": {
            "@id": "ihh:EIN-S-0074"
          },
          "ihh:quote": "Prof. Albert Einstein, author\nof the theory of relativity",
          "ihh:locator": "page OCR text, article 'Noted scientists at meeting here'"
        },
        {
          "ihh:source": {
            "@id": "ihh:EIN-S-0074"
          },
          "ihh:quote": "were the guests at\nluncheon today at the Smithsonian\nInstitution of the National Academy\nof Sciences",
          "ihh:locator": "page OCR text, article 'Noted scientists at meeting here'"
        },
        {
          "ihh:source": {
