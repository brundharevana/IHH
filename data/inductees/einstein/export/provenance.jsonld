      "prov:wasAssociatedWith": {
        "@type": "prov:Agent",
        "name": "ecas-authorship-agent (claude-opus-5-5)"
      },
      "ihh:run": {
        "@id": "ihh:run-einstein-einstein-ecas-authorship-2026-10-20"
      },
      "description": "The Atlantic Monthly: issues actively renewed from July 1934; renewed-issue list includes November 1945 (v. 176 no. 5) and November 1947 (v. 180 no. 5); contributions actively renewed from April 1931. Contribution-level renewal for the Einstein article not checked in CCE (not needed: the article fails the rule on authorship and publication date either way)."
    },
    {
      "@id": "ihh:EIN-Q-0268",
      "@type": "prov:Activity",
      "prov:startedAtTime": "2026-10-20",
      "ihh:family": "domain",
      "instrument": "web search (extended)",
      "query": "Emergency Committee of Atomic Scientists 1947 fund-raising letters signed by Einstein drafted by",
      "ihh:results": 10,
      "prov:wasAssociatedWith": {
        "@type": "prov:Agent",
        "name": "ecas-authorship-agent (claude-opus-5-5)"
      },
      "ihh:run": {
        "@id": "ihh:run-einstein-einstein-ecas-authorship-2026-10-20"
      },
      "description": "Leads: Caudill 1989 UTK dissertation; OSU 'The Effort' page (Harold Oram managed fundraising; secretaries Eileen Fry and Mary Ray); FAS copy of 1947-01-22 ECAS letter (initials 'AE/of')."
    },
    {
      "@id": "ihh:EIN-Q-0269",
      "@type": "prov:Activity",
      "prov:startedAtTime": "2026-10-20",
      "ihh:family": "institutional",
      "instrument": "curl + pdftotext (trace.tennessee.edu bitstream)",
      "query": "Caudill, 'A new sense of power: Albert Einstein and the publicity campaign for world government' (PhD diss., Univ. of Tennessee, 1989), drawn on the 23 ECAS boxes at Univ. of Chicago",
      "ihh:results": 1,
      "prov:wasAssociatedWith": {
        "@type": "prov:Agent",
        "name": "ecas-authorship-agent (claude-opus-5-5)"
      },
      "ihh:run": {
        "@id": "ihh:run-einstein-einstein-ecas-authorship-2026-10-20"
      },
      "description": "Secondary scholarship citing ECAS papers: 'Oram wrote the first telegram appeal, which Einstein signed' (May 1946); 'A planned fund-raising appeal over Einstein's signature went out in November as scheduled. It included Einstein's \"Atomic War or Peace\" article written with Swing in Atlantic Monthly'; Bethe and Weisskopf objected to 'the piece and covering letter as a communication coming from the Committee as a whole'; June 29, 1947 ECAS statement 'signed' by Einstein, Urey, Bethe, Morse, Szilard, Weisskopf and Hogness and issued at a press conference. Who drafted the November 1947 covering letter is not stated."
    },
