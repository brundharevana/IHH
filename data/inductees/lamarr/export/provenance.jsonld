    {
      "@id": "ihh:LAM-F-0058",
      "@type": "Claim",
      "text": "The Navy refused to accept the Secret Communication System during World War II.",
      "about": {
        "@id": "ihh:person-lamarr"
      },
      "ihh:category": "invention",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:LAM-S-0044"
        },
        {
          "@id": "ihh:LAM-S-0013"
        },
        {
          "@id": "ihh:LAM-S-0007"
        },
        {
          "@id": "ihh:LAM-S-0012"
        }
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "ihh:LAM-S-0044"
        },
        {
          "@id": "ihh:LAM-S-0013"
        },
        {
          "@id": "ihh:LAM-S-0007"
        },
        {
          "@id": "ihh:LAM-S-0012"
        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0044"
          },
          "ihh:quote": "The Navy refused to accept the new technology during World War II.",
          "ihh:locator": "paragraph 14"
        },
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0044"
          },
          "ihh:quote": "The first part of Lamarr and Antheil’s Secret Communication System story did not see a happy Hollywood ending.",
          "ihh:locator": "paragraph 14"
        },
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0013"
          },
          "ihh:quote": "However, the Navy rejected usage of their patent",
          "ihh:locator": "paragraph 13"
        },
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0013"
          },
          "ihh:quote": "Lamarr and Antheil introduced the idea",
          "ihh:locator": "paragraph 12"
        },
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0007"
          },
          "ihh:quote": "Lamarr donated the patent to the U.S. Naval war effort, and although the Navy didn’t employ it during WWII",
          "ihh:locator": "biography paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0012"
          },
          "ihh:quote": "Although the U.S. Navy originally rejected Lamarr's idea, they did use her concept of \"frequency-hopping\" during missions in later years.",
          "ihh:locator": "paragraph 4"
        }
      ],
      "ihh:extractor": {
