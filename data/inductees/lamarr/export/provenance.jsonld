      "@type": "Claim",
      "text": "Hedy Lamarr and George Antheil were awarded U.S. Patent 2,292,387, for a Secret Communication System, in August 1942.",
      "about": {
        "@id": "ihh:person-lamarr"
      },
      "ihh:category": "invention",
      "ihh:eventDate": "1942-08",
      "ihh:status": "single-source",
