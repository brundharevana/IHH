        {
          "ihh:source": {
            "@id": "ihh:LAM-S-0044"
          },
          "ihh:quote": "the Lamarr-Antheil duo were not recognized and awarded for their invention until the late 1990s and early 2000s. They both received the Electronic Frontier Foundation Pioneer Award and the Bulbie Gnass Spirit of Achievement Bronze Award",
          "ihh:locator": "paragraph 17"
        }
