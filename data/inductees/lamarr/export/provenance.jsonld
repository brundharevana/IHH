      "@type": "Claim",
      "text": "Lamarr and Antheil were awarded U.S. Patent 2,292,387 in 1942.",
      "about": {
        "@id": "ihh:person-lamarr"
      },
      "ihh:category": "invention",
      "ihh:eventDate": "1942",
      "ihh:status": "verified",
