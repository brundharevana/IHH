        }
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "ihh:NAI-S-0002"
        },
        {
          "@id": "ihh:NAI-S-0021"
        },
        {
          "@id": "ihh:NAI-S-0001"
        },
