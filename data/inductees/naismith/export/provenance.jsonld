        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0002"
          },
          "ihh:quote": "James Naismith wrote and developed the game’s original thirteen rules",
          "ihh:locator": "Hall of Famer page, Bio paragraph, sentence 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0002"
          },
          "ihh:quote": "James Naismith wrote and developed the game’s original thirteen rules and, through the YMCA network, quickly spread the news throughout the country.",
          "ihh:locator": "Bio, sentence 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0021"
          },
          "ihh:quote": "The boys kept nagging Naismith to let them play again, so he sat down and wrote 13 basic rules that served as the foundation for how the game is played.",
          "ihh:locator": "section 'Peach-Basket Ball', paragraph 6"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0001"
          },
          "ihh:quote": "Authored the original 13 rules of Basketball (1892)",
          "ihh:locator": "ACHIEVEMENTS section"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0004"
          },
          "ihh:quote": "Naismith then drew up the 13 original rules, which described, among other facets, the method of moving the ball and what constituted a foul. A referee was appointed. The game would be divided into two, 15-minute halves with a five-minute resting period in between. Naismith’s secretary typed up the rules and tacked them on the bulletin board.",
          "ihh:locator": "Where Basketball Originated, paragraph on rules"
        }
      ],
      "ihh:extractor": {
        "ihh:model": "claude:claude-opus-5-5",
        "ihh:runId": "naismith-2026-10-09",
        "ihh:date": "2026-10-09",
