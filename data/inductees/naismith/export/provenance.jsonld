    {
      "@id": "ihh:NAI-F-0012",
      "@type": "Claim",
      "text": "James Naismith wrote and developed the game's original thirteen rules.",
      "about": {
        "@id": "ihh:person-naismith"
      },
      "ihh:category": "work",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:NAI-S-0002"
