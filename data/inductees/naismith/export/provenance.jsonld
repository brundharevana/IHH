    {
      "@id": "ihh:NAI-F-0050",
      "@type": "Claim",
      "text": "James Naismith served as chapel director at the University of Kansas.",
      "about": {
        "@id": "ihh:person-naismith"
      },
      "ihh:category": "career",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:NAI-S-0017"
        },
        {
          "@id": "ihh:NAI-S-0003"
        },
        {
          "@id": "ihh:NAI-S-0018"
        },
        {
          "@id": "ihh:NAI-S-0019"
        },
        {
          "@id": "ihh:NAI-S-0009"
        },
        {
          "@id": "ihh:NAI-S-0015"
        }
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "ihh:NAI-S-0017"
        },
        {
          "@id": "ihh:NAI-S-0003"
        },
        {
          "@id": "ihh:NAI-S-0018"
        },
        {
          "@id": "ihh:NAI-S-0019"
        },
        {
          "@id": "ihh:NAI-S-0009"
        },
        {
          "@id": "ihh:NAI-S-0015"
        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0017"
          },
          "ihh:quote": "Almonte, Ontario, Canada native James Naismith (1861-1939) served on the staff at the University of Kansas from 1898-1937, teaching Physical Education, acting as the chapel director and University physician, and coaching basketball.",
          "ihh:locator": "Overview (scope note)"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0003"
          },
          "ihh:quote": "Physical education professor, chapel director and basketball coach at the University of Kansas (U.S.A.): 1898-1937",
          "ihh:locator": "Highlights list"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0018"
          },
          "ihh:quote": "That fall, tormented by the accidental death of a student in his gymnasium, Naismith found a fresh opportunity – as chapel director, coach, and head of physical education at the University of Kansas in Lawrence.",
          "ihh:locator": "A new opportunity at the University of Kansas"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0019"
          },
          "ihh:quote": "In 1898 he was hired by the University of Kansas to coach basketball, teach physical education, and serve as chaplain.",
          "ihh:locator": "Paragraph 3"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0009"
          },
          "ihh:quote": "1898: Becomes director of the gymnasium, campus chaplain, and basketball coach at University of Kansas.",
          "ihh:locator": "Biography of James Naismith timeline, 1898"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0015"
          },
          "ihh:quote": "The June 7, 1898 minutes of the Kansas Board of Regents meeting appointing him as Associate Professor of Physical Culture and Chapel Director are found here as are dozens of photographs of Naismith as basketball inventor and coach, teacher, researcher, fencing instructor, military chaplain (on a horse no less), husband and father and University ambassador.",
          "ihh:locator": "University of Kansas, Archivist's Statement (Rebecca Schulte), paragraph 3"
        }
      ],
      "ihh:extractor": {
        "ihh:model": "claude:claude-opus-5-5",
        "ihh:runId": "naismith-2026-10-09",
        "ihh:date": "2026-10-09",
