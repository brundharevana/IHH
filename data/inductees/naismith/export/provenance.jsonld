        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0009"
          },
          "ihh:quote": "To finance his education he accepted an appointment as instructor of physical education in the gymnasium at McGill.",
          "ihh:locator": "Athlete and Scholar"
        }
      ],
      "ihh:extractor": {
