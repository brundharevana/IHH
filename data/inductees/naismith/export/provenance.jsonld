      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0021"
          },
          "ihh:quote": "James Naismith, who in 1891 invented the game of basketball.",
          "ihh:locator": "image caption, paragraph 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0001"
          },
          "ihh:quote": "James Naismith revolutionized American culture and sports by inventing basketball in 1891.",
          "ihh:locator": "BIOGRAPHY section"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0001"
          },
          "ihh:quote": "Invented the game of Basketball (1891)",
          "ihh:locator": "ACHIEVEMENTS section"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0012"
          },
          "ihh:quote": "He had invented the game of basketball in 1891 while at the YMCA Training School and later oversaw the early development of the game while coaching the first KU basketball teams.",
          "ihh:locator": "Opening Statement, paragraph 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0004"
          },
          "ihh:quote": "Basketball is built into the fabric of Springfield College. The game was invented by Springfield College instructor and graduate student James Naismith in 1891",
          "ihh:locator": "Intro paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0004"
          },
          "ihh:quote": "The game was invented by Springfield College instructor and graduate student James Naismith in 1891, and has grown into the worldwide athletic phenomenon we know it to be today.",
          "ihh:locator": "The Birthplace of Basketball, paragraph 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0060"
          },
          "ihh:quote": "Dr. James Naismith (Wearing Suit), a Springfield College instructor and basketball’s inventor.",
          "ihh:locator": "scopeAndContentNote (original caption)"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0011"
          },
          "ihh:quote": "Although he is credited with inventing basketball while working at the Springfield, Massachusetts YMCA in 1891, James Naismith",
          "ihh:locator": "Naismith paragraph"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0022"
          },
          "ihh:quote": "Dr. James Naismith, inventor of national indoor game, is also fencing instructor at Kansas U.",
          "ihh:locator": "item.title"
        },
        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0060"
          },
          "ihh:quote": "Original caption: Dr. James Naismith (Wearing Suit), a Springfield College instructor and basketball’s inventor. He is with the “First Team”.",
          "ihh:locator": "scopeAndContentNote"
        }
      ],
