        {
          "ihh:source": {
            "@id": "ihh:NAI-S-0018"
          },
          "ihh:quote": "Gulick challenged his students, including Naismith, to create an indoor winter activity suitable for the school’s physical education courses.",
          "ihh:locator": "biography body"
        }
      ],
