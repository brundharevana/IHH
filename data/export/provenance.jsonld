            "@id": "ihh:MUI-S-0030"
          },
          "ihh:quote": "The Corwin was a revenue cutter in the service of the United States Department of the Treasury that in 1881 was sent on a mission to the Arctic Ocean",
          "ihh:locator": "item.summary[0]"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0030"
          },
          "ihh:quote": "writer John Muir (1838-1914), already well-known for his exploration of the Sierra Nevada Mountains of California, joined the expedition together with two other scientists.",
          "ihh:locator": "item.summary[0]"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0081"
          },
          "ihh:quote": "For its June 1881 voyage it was charged with making inquiries into the fate of the three vessels and rendering appropriate aid.",
          "ihh:locator": "Description, sentence 2"
        },
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0081"
          },
          "ihh:quote": "By Hooper’s invitation, John Muir accompanied the voyage.",
          "ihh:locator": "Description, sentence 5"
        }
      ],
