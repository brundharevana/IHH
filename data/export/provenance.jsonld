        {
          "ihh:source": {
            "@id": "ihh:EIN-S-0057"
          },
          "ihh:quote": "When the German National Socialist Workers Party under Adolf Hitler came to power, with its anti-Semitic rhetoric and disregard for democratic principles, Einstein emigrated to the United States (which he had first visited in 1921) to accept a position at Princeton’s Institute for Advanced Studies.",
          "ihh:locator": "Article body, paragraph beginning 'In 1921, the Nobel Prize in Physics was awarded' (snapshot line 42)"
        }
