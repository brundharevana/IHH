      "@id": "ihh:MUI-F-0040",
      "@type": "Claim",
      "text": "In 1896 Muir receives an honorary A.M. degree from Harvard University.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "award",
      "ihh:eventDate": "1896",
      "ihh:status": "disputed",
