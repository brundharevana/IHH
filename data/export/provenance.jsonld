      "@id": "ihh:ALB-F-0046",
      "@type": "Claim",
      "text": "Madeleine Albright is the author of Fascism: A Warning.",
      "about": {
        "@id": "ihh:person-albright"
      },
      "ihh:category": "work",
      "ihh:status": "verified",
      "ihh:primaryDocument": false,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:ALB-S-0025"
        },
        {
          "@id": "ihh:ALB-S-0022"
        },
        {
          "@id": "ihh:ALB-S-0015"
        }
      ],
      "prov:wasDerivedFrom": [
