    {
      "@id": "ihh:MUI-F-0063",
      "@type": "Claim",
      "text": "In 1881 John Muir joined the expedition of the revenue cutter Corwin to the Arctic Ocean.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "career",
      "ihh:eventDate": "1881",
      "ihh:place": "Arctic Ocean",
