    {
      "@id": "ihh:ALB-F-0157",
      "@type": "Claim",
      "text": "Madeleine Albright and her family fled Prague again after the 1948 communist-backed coup.",
      "about": {
        "@id": "ihh:person-albright"
      },
      "ihh:category": "immigration",
      "ihh:eventDate": "1948",
      "ihh:place": "Prague",
      "ihh:status": "single-source",
      "ihh:primaryDocument": true,
      "ihh:isDirectQuote": false,
      "citation": [
        {
          "@id": "ihh:ALB-S-0110"
        },
        {
          "@id": "ihh:ALB-S-0074"
        },
        {
          "@id": "ihh:ALB-S-0076"
        }
      ],
      "prov:wasDerivedFrom": [
