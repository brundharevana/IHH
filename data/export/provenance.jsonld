      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0022"
          },
          "ihh:quote": "her family fled from her native Czechoslovakia, first running from the Nazi regime of Germany and then the Communists from Russia",
          "ihh:locator": "post body, paragraph 3"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0003"
          },
          "ihh:quote": "As a refugee whose family fled Czechoslovakia, first from the Nazis and later from the Communists, Albright represents the highest ideals and aspirations of immigrants who come to America seeking to make major contributions to our society.",
          "ihh:locator": "inductee biography, para 4"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0009"
          },
          "ihh:quote": "When she was a child, her family fled Czechoslovakia twice—to escape first the Nazi occupation and then the 1948 Communist seizure of power.",
          "ihh:locator": "news article"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0073"
          },
          "ihh:quote": "Whereas Albright and her family were forced to flee to Britain in 1939, due to\nthe Nazi occupation of Czechoslovakia;",
          "ihh:locator": "Whereas clause"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0073"
          },
          "ihh:quote": "Whereas Albright and her family returned to Prague after the war, only to be\nforced to flee again in 1948, due to her father's opposition to\ncommunism;",
          "ihh:locator": "Whereas clause"
        }
      ],
      "ihh:extractor": {
