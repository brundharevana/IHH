    {
      "@id": "ihh:EIN-F-0089",
      "@type": "Claim",
      "text": "Albert Einstein signed a letter to President F. D. Roosevelt in August 1939.",
      "about": {
        "@id": "ihh:person-einstein"
      },
      "ihh:category": "work",
      "ihh:eventDate": "1939-08-02",
      "ihh:status": "single-source",
