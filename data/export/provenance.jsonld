      },
      "ihh:adversary": {
        "ihh:model": "codex:gpt-6.1-sol",
        "ihh:runId": "adv-albright-tour-2026-10-15",
        "ihh:date": "2026-10-15",
        "ihh:verdict": "supported",
        "ihh:quoteInSnapshot": true,
        "ihh:quoteInLive": "unreachable",
        "ihh:entailed": true,
        "ihh:addsInformation": false,
        "ihh:atomic": true,
        "ihh:sourceTypeOk": true,
        "ihh:rationale": "All three quotes appear in their snapshots; the Smithsonian and State Department passages were also readable through web search. The evidence supports the single flight event, Prague and 1948; Britannica remained unreachable."
