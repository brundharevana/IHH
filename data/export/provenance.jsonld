      "@type": "Claim",
      "text": "After the Nazis seized power in Germany, Albert Einstein immigrated to the US.",
      "about": {
        "@id": "ihh:person-einstein"
      },
      "ihh:category": "immigration",
      "ihh:status": "single-source",
      "ihh:primaryDocument": false,
