      "@id": "ihh:MUI-F-0047",
      "@type": "Claim",
      "text": "In 1911, on June 21, Muir is awarded an honorary Litt. D. degree by Yale University.",
      "about": {
        "@id": "ihh:person-muir"
      },
      "ihh:category": "award",
      "ihh:eventDate": "1911",
      "ihh:status": "single-source",
