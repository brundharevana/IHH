        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:MUI-S-0024"
          },
          "ihh:quote": "1911\nApril 21 : John Muir turns 73 years old\nSpring: Muir travels to New York, Washington, Garrison, Boston, and New Haven.\nMay 13: Muir travels to Rochester to visit Harriman\nMay 21: Muir is interviewed in the Boston Herald before speaking to the Appalachian Mountain Club.\nJune: Muir's My First Summer in the Sierra is published\nBook Review by Marion Randall Parsons (January, 1912 Sierra Club Bulletin)\nJune 17 : John Muir makes a speech to the American Alpine Club in New York, eventually published in Sierra Club Bulletin (Jan., 1924).\n\nJune 21: Muir is awarded an honorary Litt. D. degree by Yale University",
          "ihh:locator": "1911"
        }
      ],
      "ihh:extractor": {
