        },
        {
          "@id": "ihh:ALB-S-0049"
        }
      ],
      "ihh:evidence": [
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0012"
          },
          "ihh:quote": "Madeleine Korbel Albright was nominated to be the first woman Secretary of State by President William Jefferson Clinton on December 5, 1996, confirmed by the U.S. Senate on January 22, 1997, and sworn in the next day.",
          "ihh:locator": "Introduction, para 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0013"
          },
          "ihh:quote": "Madeleine Korbel Albright was nominated by President Clinton on December 5, 1996 as Secretary of State. After being unanimously confirmed by the U.S. Senate, she was sworn in as the 64th Secretary of State on January 23, 1997.",
          "ihh:locator": "Biography (1997-2001 archive), para 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0060"
          },
          "ihh:quote": "worn for the Dec. 5, 1996, public announcement of Albright’s nomination to be the 64th, and first female, U.S. Secretary of State",
          "ihh:locator": "donation list, item 1"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0049"
          },
          "ihh:quote": "For Immediate Release December 5, 1996",
          "ihh:locator": "release header"
        },
        {
          "ihh:source": {
            "@id": "ihh:ALB-S-0049"
          },
          "ihh:quote": "Today I am pleased to announce the new national security team I have selected to help us meet that responsibility: Secretary of State-designate Madeleine Albright",
          "ihh:locator": "THE PRESIDENT, paragraph 2"
        }
      ],
