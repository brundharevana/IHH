   "ihh:sourcesFile": "assets-src/albright-archives-rotunda/SOURCES.md",
   "ihh:inventoryFile": "assets-src/albright-archives-rotunda/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"National Archives Rotunda, 14 September 2016 (app/public/models/albright-archives-rotunda, built from assets-src/albright-archives-rotunda)\"",
   "name": "The Rotunda, National Archives · September 14, 2016",
   "ihh:tourLabel": "Recreation based on National Archives photographs of September 14, 2016: the Rotunda as set up for the naturalization ceremony at which Madeleine Albright spoke. It is not the place where Albright became a U.S. citizen in 1957; no source on file records that place. The mural is shown only as a blurred tonal impression; the second mural and the dome were not photographed and are plain."
  },
  {
   "@id": "ihh:line-albright:ch:citizen:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "albright:ch:citizen:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "In 1957, nine years after her family immigrated to the United States, Madeleine Albright became a U.S. citizen. Take a moment and look around.",
   "ihh:source": [
    "Albright became a U.S. citizen in 1957.",
    "Madeleine Albright was a naturalized citizen.",
    "In 1948 Albright's family immigrated to the United States."
   ],
   "citation": [
    {
     "@id": "ihh:ALB-F-0026"
    },
    {
     "@id": "ihh:ALB-F-0074"
    },
    {
     "@id": "ihh:ALB-F-0175"
    }
   ],
   "ihh:claimStatus": {
    "ALB-F-0026": "verified",
    "ALB-F-0074": "verified",
    "ALB-F-0175": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "albright",
     "ihh:chapter": "citizen",
     "ihh:role": "opening"
    }
   ],
   "about": {
    "@id": "ihh:person-albright"
   }
  },
  {
   "@id": "ihh:line-albright:15:r22",
   "@type": "SpeakableSpecification",
   "ihh:key": "albright:15:r22",
   "ihh:lineKind": "record",
   "ihh:text": "Here are photographs of the naturalization ceremony at the National Archives in Washington, D.C., on September 14, 2016, and of the rotunda, prepared for it. 59 years after she became a U.S. citizen, she was at the ceremony to make remarks.",
   "ihh:source": [
    "Albright became a U.S. citizen in 1957.",
    "On September 14, 2016, Madeleine Albright was at the naturalization ceremony at the National Archives in Washington to make remarks.",
    "Madeleine Albright make remarks during the naturalization ceremony at the National Archives in Washington, D.C., September 14, 2016.",
