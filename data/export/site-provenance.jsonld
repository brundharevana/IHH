   }
  },
  {
   "@id": "ihh:line-naismith:11:c4",
   "@type": "SpeakableSpecification",
   "ihh:key": "naismith:11:c4",
   "ihh:lineKind": "fact",
   "ihh:text": "He was chapel director at the University of Kansas.",
   "ihh:source": "James Naismith was chapel director at the University of Kansas.",
   "citation": [
    {
     "@id": "ihh:NAI-F-0093"
