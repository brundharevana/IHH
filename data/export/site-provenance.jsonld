  {
   "@id": "ihh:line-einstein:ch:big-work:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:ch:big-work:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "In September 1943, three years after he received his certificate of American citizenship, Albert Einstein was engaged in research work for the U.S. Navy, at Princeton, N.J. Walk around, if you like.",
   "ihh:source": [
    "On 1940 Oct. 1, Albert Einstein was photographed receiving from Judge Phillip Forman his certificate of American citizenship.",
    "On 1 Sept. 1943, Dr. Albert Einstein at Princeton, N.J. is engaged in research work for the U.S. Navy."
   ],
   "citation": [
    {
     "@id": "ihh:EIN-F-0051"
    },
    {
     "@id": "ihh:EIN-F-0138"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0051": "verified",
    "EIN-F-0138": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "big-work",
     "ihh:role": "opening"
    }
   ],
   "ihh:speak": "In September 1943, three years after he received his certificate of American citizenship, Albert Einstein was engaged in research work for the U.S. Navy, at Princeton, New Jersey. Walk around, if you like.",
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:2:c2",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:2:c2",
   "ihh:lineKind": "fact",
   "ihh:text": "During World War II, Albert Einstein was working as a consultant to the United States Government.",
   "ihh:source": "Albert Einstein was working as a consultant to the United States Government during World War II.",
   "citation": [
    {
     "@id": "ihh:EIN-F-0054"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0054": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "big-work",
     "ihh:role": "room-arrival"
    }
   ],
   "ihh:speak": "During World War Two, Albert Einstein was working as a consultant to the United States Government.",
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:2:c3",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:2:c3",
   "ihh:lineKind": "fact",
   "ihh:text": "In his study at Princeton, N.J., he was doing research for the Bureau of Ordnance.",
   "ihh:source": "Albert Einstein was doing research for the Bureau of Ordnance, in his study at Princeton, N.J.",
   "citation": [
    {
     "@id": "ihh:EIN-F-0055"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0055": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "big-work",
     "ihh:role": "stop",
     "ihh:stop": "desk"
    }
   ],
   "ihh:speak": "In his study at Princeton, New Jersey, he was doing research for the Bureau of Ordnance.",
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:12:r12",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:12:r12",
   "ihh:lineKind": "record",
   "ihh:text": "Here are his letters, from 1943 to 1944.",
   "ihh:source": [
    "1943-1944"
   ],
   "citation": [],
   "ihh:claimStatus": {},
   "ihh:usedIn": [
