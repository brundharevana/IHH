  },
  {
   "@id": "ihh:line-einstein:5:c1",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:5:c1",
   "ihh:lineKind": "fact",
   "ihh:text": "On October 17, 1933, Prof. Albert Einstein was taken off the liner Westernland at Quarantine, and sped ashore by tug.",
   "ihh:source": "On October 17, 1933, Prof. Albert Einstein was taken off the liner Westernland at Quarantine and sped ashore by tug.",
