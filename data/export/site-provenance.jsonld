  {
   "@id": "ihh:record-LAM-MECHANISM-RECREATION",
   "@type": "MediaObject",
   "ihh:mediaId": "LAM-MECHANISM-RECREATION",
   "name": "Secret Communication System: the record mechanism",
   "ihh:kind": "model",
   "ihh:maker": "Hedy Kiesler Markey and George Antheil (the invention); IHH (the model)",
   "ihh:date": null,
   "ihh:holder": "Drawings: National Archives at Kansas City",
   "ihh:catalogueId": "NAID 167820368, drawing sheets 1 and 2",
   "ihh:rights": "IHH recreation from public-domain drawings",
   "creditText": "3D recreation by the Immigrant Hall of Honor from the patent drawings (National Archives at Kansas City, NAID 167820368, public domain).",
   "url": "https://catalog.archives.gov/id/167820368",
   "ihh:alt": "A 3D recreation of the record mechanism in the patent drawings: a perforated paper record running from one spool over a tracker to another, with tubes down to a row of switch contacts.",
   "ihh:files": [
    "/artifacts/lamarr/mechanism.glb"
   ],
   "ihh:linkOnly": false,
   "ihh:lines": [
    {
     "ihh:label": "Patented",
     "ihh:text": "Patent 2,292,387, Secret Communication System, was patented Aug. 11, 1942.",
     "citation": {
      "@id": "ihh:LAM-F-0090"
     }
    }
   ],
   "ihh:notes": [
    {
     "ihh:label": "Player piano records",
     "ihh:text": "The Secret Communication System contemplates employing records of the type used for many years in player pianos, which consist of long rolls of paper having perforations.",
     "citation": {
      "@id": "ihh:LAM-F-0094"
     }
    },
    {
     "ihh:label": "Rows and frequencies",
     "ihh:text": "In a conventional player piano record there may be 88 rows of perforations, and in the Secret Communication System such a record would permit the use of 88 different carrier frequencies.",
     "citation": {
      "@id": "ihh:LAM-F-0095"
     }
    }
   ],
   "ihh:shownAt": [
    {
     "ihh:inductee": "lamarr",
     "ihh:chapter": "big-work",
     "ihh:stop": "mechanism"
    }
   ],
