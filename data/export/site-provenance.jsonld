   }
  },
  {
   "@id": "ihh:line-naismith:11:c3",
   "@type": "SpeakableSpecification",
   "ihh:key": "naismith:11:c3",
   "ihh:lineKind": "fact",
   "ihh:text": "At the University of Kansas, he was teaching Physical Education.",
