   "ihh:model": "app/public/models/einstein-mercer-street-front/einstein-mercer-street-front.glb",
   "ihh:glbLabel": "Recreation based on photographs: 112 Mercer Street, Princeton, New Jersey, the house front and street. Basis: Alan Richards, \"Albert Einstein's house\" (undated, winter), Shelby White and Leon Levy Archives Center, Institute for Advanced Study, IAS E 42 (CC BY 4.0); an undated colour view and a 1975 National Park Service photograph used as reference. The photographs show the house after Einstein's lifetime; it was his home until his death in 1955. Snow, wires, cars and people are not shown.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "legacy",
     "ihh:chapterTitle": "Home until 1955",
     "ihh:placeLabel": "112 Mercer Street, Princeton"
    }
   ],
