   "ihh:rules": {
    "labels": "A label or note says what the photograph shows. Where the photograph shows another day, another occasion or another building than the chapter's, the label says so.",
    "estimates": "Sizes, positions and colours a model needed but no photograph gives are modelling estimates. They are marked as estimates or interpretive in INVENTORY.md and are never stated as facts.",
    "facts": "Every spoken line about an inductee is the text of a verified fact (citation). A room note says what the model shows and rests on its room's INVENTORY.md (ihh:basis), not on a fact.",
    "rights": "A photograph is shown only when its media record is verified and its holder's own rights words make it free to use (public domain, CC0, CC BY). Others are modelling references: used to model from, their pixels never shown and never in this package.",
    "shownBy": "ihh:shownBy lists, for each part of the inventory's 'Seen' cell, the one photograph it names: a media id, a frame or a short name that SOURCES.md or INVENTORY.md ties to exactly one item, or 'yes' in a room with one photograph. A part that cannot be tied to one photograph is given as its own words with ihh:unresolved true. ihh:seenIn is the inventory's own words."
   },
   "ihh:inputs": [
    "app/src/tour/data/tour-use.generated.json (from app/src/tour/data/<slug>.js, *-artifacts.js)",
    "assets-src/<room>/SOURCES.md, INVENTORY.md, DECISION.md",
    "app/public/models/<room>/nodes.json",
    "assets-src/audio/narration/<slug>.json",
    "app/src/shared/guide/lines.json",
    "assets-src/_queue/PROGRESS.md",
    "app/CREDITS.md",
    "data/inductees/<slug>/media.jsonl, facts.jsonl"
   ],
