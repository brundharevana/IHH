   }
  },
  {
   "@id": "ihh:line-albright:21:c2",
   "@type": "SpeakableSpecification",
   "ihh:key": "albright:21:c2",
   "ihh:lineKind": "fact",
   "ihh:text": "As Secretary of State, she testified at the Senate Appropriations Committee hearings on the proposed enlargement of the NATO alliance.",
   "ihh:source": "Secretary of State Madeleine Albright testified at the Senate Appropriations Committee hearings on the proposed enlargement of the NATO alliance.",
   "citation": [
