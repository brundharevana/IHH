   }
  },
  {
   "@id": "ihh:line-einstein:6:c6",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:6:c6",
   "ihh:lineKind": "fact",
   "ihh:text": "In “Atomic War or Peace,” he discusses his opinion on the need of a supranational agreement for the regulation and use of nuclear weaponry.",
   "ihh:source": "In \"Atomic War or Peace,\" Albert Einstein discusses his opinion on the need of a supranational agreement for the regulation and use of nuclear weaponry.",
