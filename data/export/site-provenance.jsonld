   "ihh:narratesRecords": [
    {
     "@id": "ihh:record-EIN-SERIES-BRUNAUER"
    }
   ],
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:2:c4",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:2:c4",
   "ihh:lineKind": "fact",
   "ihh:text": "Nine letters were written by him to Lieutenant Stephen Brunauer, of the Research and Development Division, and the letters relate to his research with the Research and Development Division of the Navy, specifically underwater explosions and a proposed electromagnetic torpedo detonator.",
   "ihh:source": "Nine letters were written by Albert Einstein to Lieutenant Stephen Brunauer of the Research and Development Division. Albert Einstein's letters to Lieutenant Stephen Brunauer relate to Einstein's research with the Research and Development Division of the Navy, specifically underwater explosions and a proposed electromagnetic torpedo detonator.",
   "citation": [
    {
     "@id": "ihh:EIN-F-0062"
    },
    {
     "@id": "ihh:EIN-F-0063"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0062": "verified",
    "EIN-F-0063": "verified"
   },
   "ihh:usedIn": [
    {
