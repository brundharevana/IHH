   "ihh:model": "app/public/models/muir-hutchings-house/muir-hutchings-house.glb",
   "ihh:glbLabel": "Recreation based on a photograph: 'Room in the old Hutchings House -- first in the valley -- built around an 8 foot cedar tree, Yosemite Valley', Underwood & Underwood stereograph, about 1902 (Library of Congress). A room of the Hutchings hotel as photographed in 1902. One source says Muir ran a sawmill for James Hutchings in the valley after he settled there in 1869; this is not Muir's cabin, and no source places him in this room. Colours are interpretive: the photograph is black and white.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "muir",
     "ihh:chapter": "big-work",
     "ihh:chapterTitle": "Yosemite",
     "ihh:placeLabel": "The Hutchings House, Yosemite Valley (about 1902)"
    }
   ],
   "ihh:texturesFrom": [
    {
     "@id": "ihh:MUI-M-0078",
     "ihh:mediaId": "MUI-M-0078",
     "ihh:what": "wall paper, ceiling paper, bark, grass, frieze, curtain (crops, colourised)"
    }
   ],
   "ihh:sourcesFile": "assets-src/muir-hutchings-house/SOURCES.md",
   "ihh:inventoryFile": "assets-src/muir-hutchings-house/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"Room in the old Hutchings House, Yosemite (app/public/models/muir-hutchings-house, built from assets-src/muir-hutchings-house)\"",
   "name": "The Hutchings House, Yosemite Valley · about 1902",
   "ihh:tourLabel": "Recreation based on a photograph: “Room in the old Hutchings House--first in the valley--built around an 8 foot cedar tree, Yosemite Valley, Cal.”, Underwood & Underwood stereograph, about 1902 (Library of Congress). A room of the Hutchings hotel as photographed about 1902: it is not John Muir’s cabin, and no verified fact places him in this room. The people in the photograph are not modelled. Colours are interpretive: the photograph is black and white."
  },
  {
   "@id": "ihh:line-muir:ch:big-work:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "muir:ch:big-work:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "John Muir first visited Yosemite in 1868, a year after the accident. In 1871, Emerson visited him in Yosemite. Walk around, if you like.",
   "ihh:source": [
    "In 1871 Emerson visited Muir in Yosemite.",
    "An accident in 1867 nearly blinded John Muir.",
    "Muir's first visit to Yosemite was in 1868."
   ],
