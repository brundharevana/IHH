   "ihh:model": "app/public/models/muir-dunbar-high-street/muir-dunbar-high-street.glb",
   "ihh:glbLabel": "Recreation based on a listing and a reference photograph: High Street, Dunbar, from an undated photograph (NPS). At the left, 126 and 128 High Street, the birthplace of John Muir (Historic Environment Scotland); at its right the Lorne Temperance Hotel. The photograph (photographer unknown) was used as reference only, so every surface is drawn. People are not modelled.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "muir",
     "ihh:chapter": "birth",
     "ihh:chapterTitle": "Born in Dunbar",
     "ihh:placeLabel": "126 and 128 High Street, Dunbar"
    }
   ],
   "ihh:texturesFrom": [],
   "ihh:sourcesFile": "assets-src/muir-dunbar-high-street/SOURCES.md",
   "ihh:inventoryFile": "assets-src/muir-dunbar-high-street/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"High Street, Dunbar (app/public/models/muir-dunbar-high-street, built from assets-src/muir-dunbar-high-street)\"",
   "name": "High Street, Dunbar",
   "ihh:tourLabel": "Recreation based on a listing and a reference photograph: High Street, Dunbar, from an undated photograph (NPS). John Muir’s birthplace is 126 and 128 High Street, Dunbar (Historic Environment Scotland, listed building LB24825). The building is a rebuild from the listing’s description and from the photograph, which is used as reference only (its photographer is unknown), so every surface is drawn; a bay beyond the photograph’s edge follows the listing, which describes the building as it stands today. At its right, the Lorne Temperance Hotel. People are not modelled."
  },
