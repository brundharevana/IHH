    "@id": "ihh:person-lamarr"
   }
  },
  {
   "@id": "ihh:line-lamarr:9:r6",
   "@type": "SpeakableSpecification",
   "ihh:key": "lamarr:9:r6",
   "ihh:lineKind": "record",
   "ihh:text": "This mechanism is a recreation from the patent drawings: a perforated paper record running from one spool over a tracker to another.",
   "ihh:source": [
    "Recreation from the patent drawings (U.S. Patent 2,292,387)",
    "A 3D recreation of the record mechanism in the patent drawings: a perforated paper record running from one spool over a tracker to another"
   ],
