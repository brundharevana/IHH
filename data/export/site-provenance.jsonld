  {
   "@id": "ihh:room-albright-london-shelter",
   "@type": "CreativeWork",
   "additionalType": "ihh:RoomRecreation",
   "ihh:roomId": "albright-london-shelter",
   "ihh:status": "built, not shown",
   "ihh:reason": "not used (Task 13, controller ruling 2026-10-23; the owner may override). Why: no verified fact places Albright in London",
   "ihh:progressNote": "no verified fact places Albright in London",
   "isBasedOn": [
