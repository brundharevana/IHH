  {
   "@id": "ihh:line-lamarr:1:c9",
   "@type": "SpeakableSpecification",
   "ihh:key": "lamarr:1:c9",
   "ihh:lineKind": "fact",
   "ihh:text": "The United States Patent Office allowed the application of Hedy Kiesler Markey for a patent for the Secret Communication System, with 6 claims: a Notice of Allowance, November 13, 1941.",
   "ihh:source": "The United States Patent Office allowed the application of Hedy Kiesler Markey for a patent for the Secret Communication System with 6 claims; Notice of Allowance NOV 13 1941.",
   "citation": [
    {
     "@id": "ihh:LAM-F-0092"
    }
   ],
   "ihh:claimStatus": {
    "LAM-F-0092": "verified"
   },
   "ihh:usedIn": [
