   "@id": "ihh:photo-room-einstein-birth",
   "@type": "CreativeWork",
   "additionalType": "ihh:PhotoRoom",
   "name": "Ulm, Germany",
   "description": "Photo room — based on a Library of Congress photochrom (public domain), “[Ulm, Wurtemburg, Germany]”, between ca. 1890 and ca. 1900: a view of the city, not the house where he was born. The depth is estimated from the photograph; past its edges there is nothing to show.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "birth",
     "ihh:chapterTitle": "Born in Ulm",
     "ihh:placeLabel": "Ulm, Germany"
    }
   ],
