   "ihh:model": "app/public/models/muir-hetch-hetchy/muir-hetch-hetchy.glb",
   "ihh:glbLabel": "Recreation based on a photograph: Hetch Hetchy Valley, Sierra Nevada, California, before the dam -- panorama by Matt Ashby Wolfskill, about 1911 (Library of Congress). The far view is the photograph itself; the meadow is modelled to match it. John Muir signed the petition that urged Congress to defeat the Raker Bill, which called for a dam across this valley. Colours are interpretive: the photograph is black and white.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "muir",
     "ihh:chapter": "legacy",
     "ihh:chapterTitle": "Hetch Hetchy",
     "ihh:placeLabel": "Hetch Hetchy Valley (about 1911, before the dam)"
    }
   ],
