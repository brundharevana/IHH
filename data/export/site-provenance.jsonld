  {
   "@id": "ihh:photo-room-muir-arriving",
   "@type": "CreativeWork",
   "additionalType": "ihh:PhotoRoom",
   "name": "Fountain Lake, Wisconsin (1923)",
   "description": "Photo room — based on a Wisconsin Historical Society photograph (public domain): “Muir’s Fountain Lake Home”, 1923 (WHi 40628). It shows the lake from the meadow, through oak branches; the Muir farmhouse is not in it. John Muir lived continually at the Fountain Lake farm from 1849-1856. The depth is estimated from the photograph; past its edges there is nothing to show.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "muir",
     "ihh:chapter": "arriving",
     "ihh:chapterTitle": "Fountain Lake farm",
     "ihh:placeLabel": "Fountain Lake, Wisconsin (1923)"
    }
   ],
   "isBasedOn": [
