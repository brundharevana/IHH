  },
  {
   "@id": "ihh:line-einstein:6:c5",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:6:c5",
   "ihh:lineKind": "fact",
   "ihh:text": "His letter of November 29, 1947 includes the article “Atomic War or Peace,” which he authored.",
   "ihh:source": "Albert Einstein's letter of November 29, 1947 includes the article \"Atomic War or Peace,\" authored by Albert Einstein.",
   "citation": [
