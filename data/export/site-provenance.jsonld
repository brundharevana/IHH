   "ihh:model": "app/public/models/muir-north-hall/muir-north-hall.glb",
   "ihh:glbLabel": "Recreation based on a photograph: North Hall, University of Wisconsin, Madison, about 1885 (UW-Madison Archives). One source says John Muir lived in North Hall while a student (he enrolled in 1861 and left in 1863); the photograph was taken about 22 years later. Colours are interpretive: the photograph is a sepia print.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "muir",
     "ihh:chapter": "first-work",
     "ihh:chapterTitle": "Inventions, Madison",
     "ihh:placeLabel": "North Hall, Madison (about 1885)"
    }
   ],
   "ihh:texturesFrom": [],
   "ihh:sourcesFile": "assets-src/muir-north-hall/SOURCES.md",
   "ihh:inventoryFile": "assets-src/muir-north-hall/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"North Hall, University of Wisconsin, about 1885 (app/public/models/muir-north-hall, built from assets-src/muir-north-hall)\"",
   "name": "North Hall, Madison · about 1885",
   "ihh:tourLabel": "Recreation based on a photograph: North Hall, University of Wisconsin, Madison, about 1885 (UW-Madison Archives S05904). Muir had a dormitory room in North Hall; the photograph was taken years after the State Fair of 1860. Colours are interpretive: the photograph is a sepia print."
  },
  {
