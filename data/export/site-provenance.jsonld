   "ihh:model": "app/public/models/lamarr-vienna-central-cemetery/lamarr-vienna-central-cemetery.glb",
   "ihh:glbLabel": "Recreation based on a photograph: the graves of honour of Beethoven, Mozart and Schubert at the Vienna Central Cemetery, as on a postcard of around 1905 (Wien Museum, CC0). Hedy Lamarr's ashes were buried in this cemetery; her own grave, in another part of it, is not shown. The postcard is black and white, so the colours are interpretive; the trees behind are the postcard itself, repeated round the horizon.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "lamarr",
     "ihh:chapter": "legacy",
     "ihh:chapterTitle": "Later life",
     "ihh:placeLabel": "Vienna Central Cemetery (as on a postcard of around 1905)"
    }
   ],
   "ihh:texturesFrom": [
    {
     "@id": "ihh:LAM-M-0029",
     "ihh:mediaId": "LAM-M-0029",
     "ihh:what": "the trees behind (sky and printed title cut out, monuments painted out), the fronts of the three monuments, the seated figure (cut-out card), hedge foliage",
     "ihh:ownerRuling": "Owner ruling 2026-10-24: the holder's CC0 statement is accepted for this postcard; the room keeps its photo-derived textures (supersedes the 2026-10-22 reference-only listing for this item only)."
    }
   ],
   "ihh:sourcesFile": "assets-src/lamarr-vienna-central-cemetery/SOURCES.md",
   "ihh:inventoryFile": "assets-src/lamarr-vienna-central-cemetery/INVENTORY.md",
   "ihh:decisionFile": "assets-src/lamarr-vienna-central-cemetery/DECISION.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"Graves of honour, Vienna Central Cemetery, around 1905 (app/public/models/lamarr-vienna-central-cemetery, built from assets-src/lamarr-vienna-central-cemetery)\"",
   "name": "Vienna Central Cemetery · around 1905",
   "ihh:tourLabel": "Recreation based on a photograph: the graves of honour of Beethoven, Mozart and Schubert at the Vienna Central Cemetery, as on a postcard of around 1905 (Wien Museum, CC0). Hedy Lamarr’s ashes were buried at the Vienna Central Cemetery. Her grave is not shown: the room shows the composers’ graves of honour as they were around 1905. The postcard is black and white, so the colours are interpretive; the trees behind are the postcard itself, repeated round the horizon."
  },
