   "ihh:model": "app/public/models/einstein-trenton-courtroom/einstein-trenton-courtroom.glb",
   "ihh:glbLabel": "Recreation of the ceremonial courtroom (Courtroom 1) of the U.S. Post Office and Courthouse, 402 East State Street, Trenton, New Jersey (built 1932; now the Clarkson S. Fisher Federal Building and U.S. Courthouse), the courthouse of the U.S. District Court in Trenton. Modelled from the National Register photograph of the room (2005 or 2009, reference only) and the register form's description; marble from Carol M. Highsmith's 2010 photographs of the building (Library of Congress, public domain). No source places Einstein's 1940 naturalization in this room.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "citizen",
     "ihh:chapterTitle": "Becoming a citizen",
     "ihh:placeLabel": "The courthouse, Trenton"
    }
   ],
   "ihh:texturesFrom": [
    {
     "@id": "ihh:EIN-M-0073",
     "ihh:mediaId": "EIN-M-0073",
     "ihh:what": "the marble (crop of the marble pier)"
    }
   ],
   "ihh:sourcesFile": "assets-src/einstein-trenton-courtroom/SOURCES.md",
   "ihh:inventoryFile": "assets-src/einstein-trenton-courtroom/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"Ceremonial courtroom, Trenton (app/public/models/einstein-trenton-courtroom, built from assets-src/einstein-trenton-courtroom)\"",
   "name": "The courthouse, Trenton",
   "ihh:tourLabel": "Recreation of the ceremonial courtroom of the federal courthouse in Trenton, New Jersey, now the Clarkson S. Fisher Federal Building and U.S. Courthouse, the courthouse of the U.S. District Court in Trenton. Modelled from the National Register photograph of the room and the register form's description (reference only); marble from Carol M. Highsmith's 2010 photographs of the building (Library of Congress, public domain). Albert Einstein received his certificate of American citizenship in 1940; no source on file says it was in this room."
  },
  {
   "@id": "ihh:line-einstein:ch:citizen:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:ch:citizen:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "A year after his letter to the President, Albert Einstein received his certificate of American citizenship from Judge Phillip Forman, on October 1. Take a moment and look around.",
   "ihh:source": [
    "On 1940 Oct. 1, Albert Einstein was photographed receiving from Judge Phillip Forman his certificate of American citizenship.",
    "Alexander Sachs delivered Einstein's letter to President Roosevelt on October 11, 1939."
   ],
   "citation": [
    {
     "@id": "ihh:EIN-F-0051"
    },
    {
     "@id": "ihh:EIN-F-0135"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0051": "verified",
    "EIN-F-0135": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "citizen",
     "ihh:role": "opening"
    }
   ],
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:1:c8",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:1:c8",
   "ihh:lineKind": "fact",
   "ihh:text": "His Petition for Naturalization has petition number 4009, assigned by the U.S. District Court for the District of New Jersey, Trenton.",
   "ihh:source": "Albert Einstein's Petition for Naturalization has petition number 4009, assigned by the U.S. District Court for the District of New Jersey, Trenton.",
   "citation": [
    {
     "@id": "ihh:EIN-F-0056"
    }
   ],
   "ihh:claimStatus": {
    "EIN-F-0056": "verified"
   },
   "ihh:usedIn": [
    {
     "ihh:inductee": "einstein",
     "ihh:chapter": "citizen",
     "ihh:role": "room-arrival"
    }
   ],
   "ihh:speak": "His Petition for Naturalization has petition number forty oh nine, assigned by the U.S. District Court for the District of New Jersey, in Trenton.",
   "about": {
    "@id": "ihh:person-einstein"
   }
  },
  {
   "@id": "ihh:line-einstein:12:r10",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:12:r10",
   "ihh:lineKind": "record",
   "ihh:text": "Here is his record of naturalization, at the National Archives at Philadelphia: a Certificate of Arrival, a Declaration of Intention, a Petition for Naturalization and an Oath of Allegiance.",
   "ihh:source": [
    "Record of naturalization for Albert Einstein which includes a Certificate of Arrival, Declaration of Intention, Petition for Naturalization, and Oath of Allegiance.",
    "National Archives at Philadelphia"
   ],
