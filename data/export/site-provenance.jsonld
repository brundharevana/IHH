   "ihh:model": "app/public/models/albright-archives-rotunda/albright-archives-rotunda.glb",
   "ihh:glbLabel": "Recreation based on photographs: the Rotunda of the National Archives, Washington, 14 September 2016, prepared for the naturalization ceremony at which Madeleine Albright spoke (National Archives, 64-CFDA-20160914-01-027, -060, -095, -100, -117). This is not her own naturalization (1957); no source records where that took place.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "albright",
     "ihh:chapter": "citizen",
     "ihh:chapterTitle": "A U.S. citizen",
     "ihh:placeLabel": "The Rotunda, National Archives, Washington (2016)"
    }
   ],
   "ihh:texturesFrom": [
    {
