   }
  },
  {
   "@id": "ihh:line-naismith:12:r4",
   "@type": "SpeakableSpecification",
   "ihh:key": "naismith:12:r4",
   "ihh:lineKind": "record",
   "ihh:text": "Here is The Topeka state journal of September 10, 1898. He was a resident of Denver, and he succeeded Rev. Hector Cowan as the new director of physical culture.",
   "ihh:source": [
    "The Topeka state journal (Topeka, Kansas), September 10, 1898",
    "Naismith succeeded Rev. Hector Cowan as the new director of physical culture.",
    "Naismith was a resident of Denver."
   ],
