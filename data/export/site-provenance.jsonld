   "ihh:creditsSection": "app/CREDITS.md, section \"Naismith rooms (app/public/models/naismith-springfield-gym, naismith-robinson-gym; built from assets-src/naismith-*)\"",
   "name": "The gymnasium, Springfield",
   "ihh:tourLabel": "Recreation based on photographs titled “School for Christian Workers Gymnasium” in the Springfield College Archives and Special Collections (reference only). The peach basket and the ball on the floor are labelled recreations; the originals were not preserved."
  },
  {
   "@id": "ihh:line-naismith:ch:first-work:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "naismith:ch:first-work:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "In December 1891, James Naismith invented basketball in Springfield. That was four years after he entered the Presbyterian College. He was a Springfield College instructor, and Gulick challenged him. Walk around, if you like.",
   "ihh:source": [
    "Dr. James Naismith was a Springfield College instructor.",
    "Gulick challenged Naismith.",
    "In 1887 Naismith entered the Presbyterian College in Montreal.",
    "In December 1891 Naismith invented basketball in Springfield."
   ],
