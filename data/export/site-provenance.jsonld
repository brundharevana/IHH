   "ihh:model": "app/public/models/albright-oval-office-1993/albright-oval-office-1993.glb",
   "ihh:glbLabel": "Recreation based on photographs: the Oval Office as photographed in April 1993 (White House Photograph Office, Bob McNeely, 20 April 1993; National Archives). The photographs are black and white, so the colours are interpretive; the pictures on the walls are shown as soft impressions. People in the photographs are not modelled.",
   "ihh:shownIn": [
    {
     "ihh:inductee": "albright",
     "ihh:chapter": "secretary",
     "ihh:chapterTitle": "Secretary of State",
     "ihh:placeLabel": "The Oval Office as photographed in April 1993"
    }
   ],
   "ihh:texturesFrom": [
    {
     "@id": "ihh:ALB-M-0088",
     "ihh:mediaId": "ALB-M-0088",
     "ihh:what": "frame 16: view through the window, drape fabric, the east landscape (impression), the bronze (cut-out card)"
    },
    {
     "@id": "ihh:ALB-M-0089",
     "ihh:mediaId": "ALB-M-0089",
     "ihh:what": "frame 24 (President Clinton with President Havel; no person is modelled): the jars' decoration, the plant and the bust (cut-out cards), the landscape (impression)"
    },
    {
     "ihh:ruledItems": [
      "16, 17, 18",
      "09, 10, 11, 12, 13, 14, 15",
      "19, 20, 21, 22, 23, 24",
      "25, 26, 27, 29, 30, 31"
     ],
     "ihh:inheritsRecord": {
      "@id": "ihh:ALB-M-0088"
     },
     "ihh:what": "the other frames of roll WHPO-P02724 (09-15, 17-23, 25-27, 29-31): texture crops listed in SOURCES.md under the same holder statement",
     "ihh:ownerRuling": "Owner ruling 2026-10-24: every frame of NARA roll WHPO-P02724 (William J. Clinton Library, White House Photograph Office, Oval Office, 20 April 1993; file unit NAID 187792855, use restriction \"Unrestricted\") inherits the roll's federal public-domain status, so textures may come from any frame of the roll. Frames 16 and 24 are the media records ALB-M-0088 and ALB-M-0089."
    }
   ],
   "ihh:sourcesFile": "assets-src/albright-oval-office-1993/SOURCES.md",
   "ihh:inventoryFile": "assets-src/albright-oval-office-1993/INVENTORY.md",
   "ihh:creditsSection": "app/CREDITS.md, section \"Oval Office, April 1993 (app/public/models/albright-oval-office-1993, built from assets-src/albright-oval-office-1993)\"",
   "name": "The Oval Office · as photographed in April 1993",
   "ihh:tourLabel": "Recreation based on photographs: the Oval Office as photographed in April 1993 (White House Photograph Office, Bob McNeely, roll WHPO-P02724, April 20, 1993; National Archives, public domain). On April 20, 1993, President Clinton was speaking with Ambassador to the United Nations Madeleine Albright in the Oval Office. This is the room as photographed that day, not on the day she was sworn in as Secretary of State, January 23, 1997. The photographs are black and white, so the colours are interpretive; the pictures on the walls are soft impressions. People are not modelled."
  },
  {
   "@id": "ihh:line-albright:ch:secretary:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "albright:ch:secretary:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "On January 22, 1997, Madeleine Albright was confirmed as Secretary of State by the U.S. Senate. She was sworn in, in the Oval Office, on January 23, 1997, and Vice President Gore administered the oath of office. Take a moment and look around.",
   "ihh:source": [
    "Madeleine Korbel Albright was confirmed as Secretary of State by the U.S. Senate on January 22, 1997.",
    "Vice President Gore administered the oath of office at the swearing-in ceremony of Madeleine Albright as Secretary of State.",
    "Madeleine Albright was sworn in as Secretary of State in the Oval Office on January 23, 1997."
   ],
   "citation": [
