  {
   "@id": "ihh:line-einstein:ch:arriving:opening",
   "@type": "SpeakableSpecification",
   "ihh:key": "einstein:ch:arriving:opening",
   "ihh:lineKind": "opening",
   "ihh:text": "Albert Einstein immigrated to the United States. In October 1933, the same year he renounced his German citizenship, his party landed at the Battery, in New York. Have a look around.",
   "ihh:source": [
    "Albert Einstein immigrated to the United States.",
    "In 1933 Albert Einstein renounced his German citizenship.",
    "On October 17, 1933, the Einstein party landed at the Battery in New York."
   ],
