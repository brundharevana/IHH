---
// Living painted portrait with labeled AI-voice quotes. Props come from src/content/portrait.js:
//   portrait = portraitView(...) -> { image, depth, alt, badge }
//   quotes   = quoteViews(...)   -> [{ id, text, voiceLabel, source, audio: { mp3, vtt } | null }]
// The AI voice label appears only for a quote that has audio; without audio the words are shown
// in the transcript with their source and nothing is voiced.
// Motion and audio are wired by src/ui/portrait.js. Nothing plays until a button is pressed.
import FactChips from './FactChips.astro';
const { portrait, quotes = [], width = 648, height = 800 } = Astro.props;
const voiced = quotes.filter(q => q.audio);
const many = voiced.length > 1;
---
<figure class="portrait" data-depth={portrait.depth}>
  <div class="portrait-frame" style={`aspect-ratio:${width}/${height}`}>
    <img class="still" src={portrait.image} alt={portrait.alt} width={width} height={height} />
    <canvas aria-hidden="true" hidden></canvas>
    <p class="portrait-caption" data-caption aria-hidden="true" hidden></p>
  </div>
  <figcaption>
    <p class="portrait-badge">{portrait.badge} <a href="/how-this-was-made/#portraits">How these portraits were made</a></p>
    <button type="button" class="portrait-btn" data-motion hidden>Pause motion</button>
    {voiced.length > 0 && (
      <ul class="portrait-quotes">
        {voiced.map((q, i) => (
          <li>
            <button type="button" class="portrait-btn" data-quote={q.id}>{many ? `Hear the quote ${i + 1}` : 'Hear the quote'}</button>
            <audio data-audio={q.id} preload="none" src={q.audio.mp3}>
              <track kind="captions" srclang="en" label="English" src={q.audio.vtt} default />
            </audio>
            <p class="portrait-missing" data-audio-missing={q.id} hidden>Audio unavailable. The words are in the transcript.</p>
            <p class="voice-label">{q.voiceLabel}</p>
          </li>
        ))}
      </ul>
    )}
    {quotes.length > 0 && (
      <details class="portrait-transcript">
        <summary>Transcript</summary>
        {quotes.map(q => (
          <div data-transcript={q.id}>
            <blockquote><p>{q.text}</p></blockquote>
            <p class="portrait-source">Source: {q.source}.{q.audio ? ` ${q.voiceLabel}` : ''} <FactChips chips={q.attributionChips || []} prefix={`tip-${q.id}-attr`} /></p>
          </div>
        ))}
      </details>
    )}
  </figcaption>
</figure>

<script>
  import { mountPortraits } from '../ui/portrait.js';
  mountPortraits();
</script>

<style is:global>
  .portrait { margin: var(--space-5) 0; max-width: 480px; }
  .portrait [hidden] { display: none !important; }
  .portrait-frame { position: relative; width: 100%; background: #1f1d1a; border-radius: 4px; overflow: hidden; }
  .portrait-frame img.still, .portrait-frame canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .portrait-caption { position: absolute; left: var(--space-2); right: var(--space-2); bottom: var(--space-2); margin: 0;
    padding: var(--space-2) var(--space-3); background: rgba(20, 18, 16, 0.88); color: #fbf8f2; border-radius: 3px;
    font-size: 1rem; line-height: 1.4; text-align: center; }
  .portrait figcaption { margin-top: var(--space-3); }
  .portrait-badge { margin: 0 0 var(--space-3); padding: var(--space-2) var(--space-3); border-left: 3px solid var(--c-accent);
    background: #fffdf8; font-size: 0.875rem; line-height: 1.45; }
  .portrait-badge a, .portrait-transcript a { color: var(--c-accent); }
  .portrait-btn { min-height: 44px; min-width: 44px; padding: var(--space-2) var(--space-4); font: inherit; color: var(--c-ink);
    background: #fff; border: 1px solid var(--c-muted); border-radius: 6px; cursor: pointer; }
  .portrait-btn:disabled { cursor: not-allowed; opacity: 0.6; }
  .portrait-quotes { list-style: none; padding: 0; margin: var(--space-3) 0; display: grid; gap: var(--space-3); }
  .portrait .voice-label { margin: var(--space-1) 0 0; font-size: 0.875rem; color: var(--c-muted); }
  .portrait-missing { margin: var(--space-1) 0 0; font-size: 0.875rem; }
  .portrait-transcript summary { min-height: 24px; cursor: pointer; }
  .portrait-transcript blockquote { margin: var(--space-2) 0; font-family: var(--f-serif); }
  .portrait-source { font-size: 0.875rem; color: var(--c-muted); }
</style>
